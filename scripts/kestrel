#!/usr/bin/env bash
# Kestrel CLI shim — delegates to the self-hosted Kestrel CLI after bootstrap.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"; SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"; export KESTREL_ROOT="$ROOT"
COMPILER="$ROOT/compiler"; COMPILER_CLI="$COMPILER/dist/cli.js"
TS_CLI_SOURCE="$ROOT/stdlib/kestrel/tools/cli.ks"
if [ -n "${KESTREL_JVM_CACHE:-}" ]; then
  echo "kestrel: KESTREL_JVM_CACHE is deprecated; use KESTREL_TS_CACHE instead" >&2
  JVM_CACHE="$KESTREL_JVM_CACHE"
else
  JVM_CACHE="${KESTREL_TS_CACHE:-$HOME/.kestrel/ts}"
fi
SELF_CACHE="${KESTREL_SELF_CACHE:-$HOME/.kestrel/self}"
MAVEN="${KESTREL_MAVEN_CACHE:-$HOME/.kestrel/maven}"
MAVEN_RUNTIME_JAR="$MAVEN/lang/kestrel/runtime/1.0/runtime-1.0.jar"
MAVEN_BOOTSTRAP_JAR="$MAVEN/lang/kestrel/compile/1.0/compile-1.0.jar"

# Ensure the TS cache contains a current Cli.class for ./kestrel default mode.
ensure_ts_cli_class() {
  local ts_cli
  ts_cli=$(find "$JVM_CACHE" -name "Cli.class" -path "*/kestrel/tools/Cli.class" 2>/dev/null | head -1 || true)
  if [ -n "$ts_cli" ]; then
    return 0
  fi

  # If compiler output is missing, build it first.
  if [ ! -f "$COMPILER_CLI" ]; then
    command -v node >/dev/null || return 1
    (cd "$COMPILER" && npm run build >/dev/null 2>&1) || return 1
  fi

  mkdir -p "$JVM_CACHE"
  command -v node >/dev/null || return 1
  node "$COMPILER_CLI" "$TS_CLI_SOURCE" --target jvm -o "$JVM_CACHE" >/dev/null 2>&1 || return 1
}

# --allow-ts-compiler __ts-compile: direct TypeScript compiler invocation (bootstrap only)
if [ "${1:-}" = "--allow-ts-compiler" ] && [ "${2:-}" = "__ts-compile" ]; then
  shift 2; exec node "$COMPILER_CLI" "$1" --target jvm -o "$2" "${@:3}"
fi

# bootstrap: deprecated — forward to kestrel-self bootstrap
if [ "${1:-}" = "bootstrap" ]; then
  echo "kestrel: 'kestrel bootstrap' is deprecated; use './kestrel-self bootstrap' instead" >&2
  exec "$ROOT/scripts/kestrel-self" bootstrap
fi

# build (no args): rebuild TypeScript compiler and JVM runtime from source
if [ "${1:-}" = "build" ] && [ -z "${2:-}" ]; then
  command -v node >/dev/null || { echo "kestrel: node not found" >&2; exit 1; }
  command -v javac >/dev/null || { echo "kestrel: javac not found" >&2; exit 1; }
  (cd "$COMPILER" && npm run build >/dev/null 2>&1) || { echo "kestrel: compiler build failed" >&2; exit 1; }
  (cd "$ROOT/runtime/jvm" && bash build.sh >/dev/null 2>&1) || { echo "kestrel: JVM runtime build failed" >&2; exit 1; }
  mkdir -p "$(dirname "$MAVEN_RUNTIME_JAR")" && cp "$ROOT/runtime/jvm/kestrel-runtime.jar" "$MAVEN_RUNTIME_JAR"; exit 0
fi

# test: generate and run the synthetic test runner via `run`.
# This avoids self-hosted `cmdTest` exiting early when async work is still pending.
if [ "${1:-}" = "test" ]; then
  # `kestrel test` should require self-hosted compiler artifacts before bootstrap.
  SELF_CLI_CLASS=$(find "$SELF_CACHE" -name "Cli.class" -path "*/kestrel/tools/Cli.class" 2>/dev/null | head -1 || true)
  if [ -z "$SELF_CLI_CLASS" ]; then
    echo "kestrel: self-hosted compiler artifacts are required for this command" >&2
    echo "  run: ./scripts/build-bootstrap-jar.sh && ./kestrel bootstrap" >&2
    exit 1
  fi
  shift
  "$0" run "$ROOT/stdlib/kestrel/tools/test.ks" --generate "$@" || exit $?
  exec "$0" run "$ROOT/.kestrel_test_runner.ks"
fi

# All other commands: delegate to the self-hosted Kestrel CLI
# First, try to ensure TS Cli.class exists so ./kestrel stays on TS-default path.
ensure_ts_cli_class || true

# Look for Cli.class in JVM_CACHE first (TS-compiled, for ./kestrel default path),
# then fall back to SELF_CACHE (self-hosted bootstrap/compiled classes, for ./kestrel-self).
CLI_CLASS=$(find "$JVM_CACHE" "$SELF_CACHE" -name "Cli.class" -path "*/kestrel/tools/Cli.class" 2>/dev/null \
  | head -1) || CLI_CLASS_FILE=""
if [ -n "$CLI_CLASS" ]; then
  # Determine which cache the class came from to build the correct classpath
  if [[ "$CLI_CLASS" == "$JVM_CACHE"* ]]; then
    CLI_CLASS_NAME=$(echo "$CLI_CLASS" | sed "s|$JVM_CACHE/||;s|\.class\$||" | tr '/' '.')
    exec java -Xss8m -Dkestrel.exitWait=false -cp "$MAVEN_RUNTIME_JAR:$JVM_CACHE:$SELF_CACHE" "$CLI_CLASS_NAME" "$@"
  else
    CLI_CLASS_NAME=$(echo "$CLI_CLASS" | sed "s|$SELF_CACHE/||;s|\.class\$||" | tr '/' '.')
    exec java -Xss8m -Dkestrel.exitWait=false -cp "$MAVEN_RUNTIME_JAR:$JVM_CACHE:$SELF_CACHE" "$CLI_CLASS_NAME" "$@"
  fi
fi
echo "kestrel: self-hosted compiler artifacts are required for this command" >&2
echo "  run: ./scripts/build-bootstrap-jar.sh && ./kestrel bootstrap" >&2
exit 1
